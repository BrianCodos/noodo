  "findings": [
    "One system sans stack in each view, but not centralized; Inter was named without a supplied font file.",
    "Inconsistent size, weight and tracking created the appearance of multiple typefaces.",
    "Metadata as small as 6px and pervasive uppercase reduced hierarchy and readability.",
    "The documented scale did not match actual component styles."
  ],
  "decisions": [
    "One shared system sans family; official PP Neue Montreal remains pending.",
    "Six semantic roles: display, title, heading, body, label, meta.",
    "Only 400, 500 and 600 weights in UI; wordmark is a brand exception.",
    "Sentence case; uppercase only NOODO, IA, UI, CSS and identifiers.",
    "No UI text below 12px; responsive display/title only."
  ]
}